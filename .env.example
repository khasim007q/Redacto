# Redacto configuration. Copy to .env and adjust for local runs.

# Graph/plan/action/receipt database
REDACTO_DB_PATH=var/redacto.sqlite3

# Explicit adapter scope (all local, synthetic fixtures only)
REDACTO_WORKSPACE_ROOT=fixtures/workspace
REDACTO_SQLITE_PATH=fixtures/workspace/agent_memory.sqlite3
REDACTO_JSONL_PATH=fixtures/workspace/agent_events.jsonl
REDACTO_VECTOR_PATH=fixtures/workspace/vector_chunks.json

# Versioned keyed-fingerprint key ring. Replace for anything beyond synthetic fixtures.
# During rotation keep old versions here until `redacto keyring` reports them retirable.
REDACTO_HMAC_KEY_VERSION=1
# REDACTO_HMAC_KEYS={"1":"old-key","2":"new-key"}
REDACTO_HMAC_KEY=dev-only-synthetic-fixture-key

# review (default) | strict | dry_run_only
REDACTO_SAFETY_MODE=review
REDACTO_DRY_RUN=true
REDACTO_MAX_SCAN_RECORDS=500

# Embedding paraphrase signal. Local deterministic provider; never proof of lineage.
REDACTO_EMBEDDING_PROVIDER=local_hashing
# Calibrated on the labelled synthetic set (see `redacto calibrate-embeddings`).
REDACTO_EMBEDDING_CANDIDATE_THRESHOLD=0.25
REDACTO_EMBEDDING_QUARANTINE_THRESHOLD=0.30

# Runtime model assessment. Disabled by default; deterministic flow always works.
REDACTO_MODEL_PROVIDER=none
# REDACTO_MODEL_PROVIDER=openai_compatible
# REDACTO_MODEL_BASE_URL=http://127.0.0.1:11434/v1
# REDACTO_MODEL_NAME=llama3.1
REDACTO_MODEL_TIMEOUT=10

# Optional real stores. Each joins the scope only when configured.
# Chroma (pip install 'redacto[chroma]'): a persistent client folder + the collections
# Redacto may touch.
# REDACTO_CHROMA_PATH=/path/to/chroma
# REDACTO_CHROMA_COLLECTIONS=agent_docs,agent_memory
# Redis cache (pip install 'redacto[redis]'): key patterns in scope; a bare * is refused.
# REDACTO_REDIS_URL=redis://127.0.0.1:6379/0
# REDACTO_REDIS_KEY_PATTERNS=llm-cache:*,embeddings-cache:*

# Rebuild confirmed derivatives from their remaining allowed sources instead of deleting
# them. Needs the model settings above; every rewrite is leak-checked before it is written.
REDACTO_REGENERATE=false

# Streamable HTTP mode
REDACTO_HTTP_HOST=127.0.0.1
REDACTO_HTTP_PORT=8765
# Required for HTTP transport. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# REDACTO_HTTP_TOKEN=
