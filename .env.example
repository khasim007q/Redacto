# Redacto configuration. Copy to .env and adjust for local runs.

# Graph/plan/action/receipt database
REDACTO_DB_PATH=var/redacto.sqlite3

# Explicit adapter scope (all local, synthetic fixtures only)
REDACTO_WORKSPACE_ROOT=fixtures/workspace
REDACTO_SQLITE_PATH=fixtures/workspace/agent_memory.sqlite3
REDACTO_JSONL_PATH=fixtures/workspace/agent_events.jsonl
REDACTO_VECTOR_PATH=fixtures/workspace/vector_chunks.json

# Keyed fingerprint key. Replace for anything beyond synthetic fixtures.
REDACTO_HMAC_KEY=dev-only-synthetic-fixture-key

# review (default) | strict | dry_run_only
REDACTO_SAFETY_MODE=review
REDACTO_DRY_RUN=true
REDACTO_MAX_SCAN_RECORDS=500

# Runtime model assessment. Disabled by default; deterministic flow always works.
REDACTO_MODEL_PROVIDER=none
# REDACTO_MODEL_PROVIDER=openai_compatible
# REDACTO_MODEL_BASE_URL=http://127.0.0.1:11434/v1
# REDACTO_MODEL_NAME=llama3.1
REDACTO_MODEL_TIMEOUT=10

# Streamable HTTP mode
REDACTO_HTTP_HOST=127.0.0.1
REDACTO_HTTP_PORT=8765
# Required for HTTP transport. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# REDACTO_HTTP_TOKEN=
