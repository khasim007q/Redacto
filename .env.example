# Recommended: redacto setup --workspace /absolute/path/to/notes
# Then set the generated profile path. No sample data is created.
REDACTO_PROFILE=/absolute/path/to/profile.json

# Optional HTTP transport. Set a strong random token outside version control.
# REDACTO_HTTP_TOKEN=<random-token>
# REDACTO_HTTP_HOST=127.0.0.1
# REDACTO_HTTP_PORT=8765
# REDACTO_HTTP_ALLOWED_HOSTS=mcp.example:443,mcp.example
# REDACTO_HTTP_ALLOWED_ORIGINS=https://trusted-client.example

# Advanced environment-only configuration (omit REDACTO_PROFILE):
# REDACTO_WORKSPACE_ROOT=/absolute/path/to/notes
# REDACTO_DB_PATH=/private/state/redacto.sqlite3
# REDACTO_HMAC_KEYS={"1":"<random-key>"}
# REDACTO_HMAC_KEY_VERSION=1
# REDACTO_STORES=filesystem,sqlite_memory,jsonl_logs,chroma,redis_cache
# REDACTO_SQLITE_PATH=/application/memory.sqlite3
# REDACTO_JSONL_PATH=/application/events.jsonl
# REDACTO_CHROMA_PATH=/application/chroma
# REDACTO_CHROMA_COLLECTIONS=context
# REDACTO_REDIS_URL=redis://127.0.0.1:6379/0
# REDACTO_REDIS_KEY_PATTERNS=llm-cache:*
